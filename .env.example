# ──────────────────────────────────────────────────────────────────────────────
# CLIENT-EXPOSED env (Vite injects all VITE_* into the browser bundle).
# Safe to put public keys here. NEVER put secrets behind a VITE_ prefix.
# ──────────────────────────────────────────────────────────────────────────────

# Cloudflare Turnstile site key (public). Get from CF dashboard → Turnstile.
# Leave blank in dev to skip the captcha widget gracefully.
VITE_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
VITE_GA_MEASUREMENT_ID=

# Google Ads conversion (used together to fire conversion on lead submit).
VITE_GOOGLE_ADS_CONVERSION_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=

# Meta (Facebook) Pixel ID for `Lead` event tracking.
VITE_META_PIXEL_ID=

# ──────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY env (Cloudflare Workers — set in wrangler.jsonc `vars`
# or via `wrangler secret put <NAME>` for sensitive values).
# These are NEVER shipped to the browser.
# ──────────────────────────────────────────────────────────────────────────────

# Google Apps Script webhook URL — receives sanitized leads server-to-server.
# Set in wrangler.jsonc `vars` (non-sensitive) or via `wrangler secret put`.
LEAD_WEBHOOK_URL=

# Cloudflare Turnstile secret key. Set with: `wrangler secret put TURNSTILE_SECRET_KEY`
TURNSTILE_SECRET_KEY=
