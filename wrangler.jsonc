{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",

  // Server-only env vars. These are available to the Worker, not the browser bundle.
  "vars": {
    "LEAD_WEBHOOK_URL": "https://script.google.com/macros/s/AKfycbz4mTI0wx2ng4zZf8iTDDzHjy41gjXj_7A3dhIpZfybdKJ8yT9nJ3wy-yghwf3gbu01cQ/exec",
  },

  // Required production secrets. Keep values out of this file.
  // First deploy: wrangler deploy --secrets-file .dev.vars
  // Later rotation: wrangler secret put <NAME>
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"],
  },

  // KV namespace for lead form rate-limiting + dedupe.
  // Create with: `wrangler kv namespace create LEADS_RL`
  // then paste the returned `id` below (and a separate `preview_id` for `wrangler dev`).
  "kv_namespaces": [
    {
      "binding": "LEADS_RL",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_KV_NAMESPACE_PREVIEW_ID",
    },
  ],

  // Secret values are stored in Cloudflare, not committed to git.
}
